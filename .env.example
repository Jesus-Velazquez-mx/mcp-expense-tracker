# Protocolo HTTP
HTTP

# Host
HOST=localhost

# Puerto del servidor MCP
PORT=5000

# Ruta completa del servidor MCP para el cliente
MCP_SERVER_URL=http://localhost:5000/mcp

# Configuración del LLM local (Ollama)
LLM_BASE_URL=http://localhost:11434
LLM_CHAT_PATH=/api/chat
LLM_MODEL=gemma4:e4b

